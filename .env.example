# ─────────────────────────────────────────────────────────────
# Sofia Transit Tracker - Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# cp .env.example .env.local

# ── NextAuth ──────────────────────────────────────────────────
# A random secret used to sign/encrypt JWT sessions.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# The public URL of your deployment (no trailing slash).
# In development this is usually http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
#  1. Create a new project (or use an existing one)
#  2. Go to APIs & Services > Credentials > Create Credentials > OAuth 2.0 Client IDs
#  3. Application type: Web application
#  4. Authorised redirect URIs:
#       http://localhost:3000/api/auth/callback/google
#       https://yourdomain.com/api/auth/callback/google  (production)
#  5. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Firebase ──────────────────────────────────────────────────
# These values come from your Firebase project settings:
# Firebase Console > Project Settings > Your apps > Firebase SDK snippet > Config
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAZ9ac2o-yVuaN_VlBvkTFNTiK7BI_66no
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sofiatraffic-9cf26.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sofiatraffic-9cf26
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sofiatraffic-9cf26.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=415866576936
NEXT_PUBLIC_FIREBASE_APP_ID=1:415866576936:web:4fe3d26f6076677ee3951d
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-V7XLENBX68
